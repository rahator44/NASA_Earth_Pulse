# ==============================================================================
# NISAR Surface Change Explorer — Environment Configuration Template
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# NOTE: The web application runs 100% out of the box WITHOUT any credentials!
# All real showcase data, live DAAC metadata search, map inspection, and 
# lab tools operate immediately without NASA Earthdata Login.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NASA Earthdata Login (OPTIONAL)
# ------------------------------------------------------------------------------
# ONLY needed if you want to re-run the offline raw granule streaming script
# (scripts/real_flood/run_showcase.py) to fetch multi-gigabyte HDF5 granules.
#
# Anyone can register for a free NASA Earthdata account at:
# https://urs.earthdata.nasa.gov/users/new
#
# You can provide credentials here, OR in your ~/.netrc file:
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# ------------------------------------------------------------------------------
# 2. Mapbox Public Access Token (OPTIONAL)
# ------------------------------------------------------------------------------
# If left empty, the application automatically uses free CartoDB Dark Matter / 
# OpenStreetMap tile layers with full MapLibre GL functionality.
MAPBOX_PUBLIC_TOKEN=
